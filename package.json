{
  "name": "@rhythmjs/testing",
  "version": "0.0.3",
  "description": "Testing utilities for Rhythm: kernel module mocking, a fetch-based router test client, a CLI command runner, and WebSocket hook harnesses.",
  "keywords": [
    "cli",
    "inject",
    "mock",
    "rhythm",
    "supertest",
    "test-client",
    "testing",
    "websocket"
  ],
  "homepage": "https://rhythm.js.org/testing",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/testing.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./rhythm": {
      "types": "./dist/rhythm/rhythm.d.ts",
      "default": "./dist/rhythm/rhythm.js"
    },
    "./router": {
      "types": "./dist/router/router.d.ts",
      "default": "./dist/router/router.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "default": "./dist/cli/cli.js"
    },
    "./ws": {
      "types": "./dist/ws/ws.d.ts",
      "default": "./dist/ws/ws.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/rhythm/rhythm.ts src/router/router.ts src/cli/cli.ts src/ws/ws.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@rhythmjs/cli": "^0.0.16",
    "@rhythmjs/rhythm": "^0.0.16",
    "@rhythmjs/router": "^0.0.16",
    "@rhythmjs/ws": "^0.0.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rhythmjs/cli": ">=0.0.15",
    "@rhythmjs/rhythm": ">=0.0.15",
    "@rhythmjs/router": ">=0.0.14",
    "@rhythmjs/ws": ">=0.0.4"
  },
  "peerDependenciesMeta": {
    "@rhythmjs/cli": {
      "optional": true
    },
    "@rhythmjs/router": {
      "optional": true
    },
    "@rhythmjs/ws": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
